# --- database ---
POSTGRES_USER=spry
POSTGRES_PASSWORD=spry
POSTGRES_DB=spry
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://spry:spry@db:5432/spry
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / cert-* / domain) ---
# Everything lands in AWS_REGION, tagged PROJECT_NAME=<PROJECT_NAME> (the
# frontend's certificate is always us-east-1, as CloudFront requires).
AWS_REGION=eu-central-1
PROJECT_NAME=spry
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role. Never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# Optional - leave both empty to skip custom domains. The API is then served
# over HTTPS from a *.cloudfront.net address and so is the frontend.
# With a domain: API_DOMAIN gets an ALB certificate (make cert-backend);
# APP_DOMAIN is the frontend's domain (make domain) and is allowed by CORS.
API_DOMAIN=
APP_DOMAIN=

# Written by make deploy-backend; make deploy-frontend builds against it.
BACKEND_URL=
# Written by make domain.
DOMAIN_NAME=

# Lab 5 (infra/reports.tf, report_email): an SES identity you verified, used as sender and recipient.
REPORT_EMAIL=

# --- Sign-in with Google, through Cognito (Lab 4) ---------------------------
# From the Google Cloud console (Google Auth Platform -> Clients). `make
# auth-uris` prints the URLs that client must list. The secret stays in .env,
# which is gitignored: never commit it, never put it in the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- paste an agenda (make llm-hello / parse / deploy-ai) ---
# PARSER_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0   # the default; or global.anthropic.claude-sonnet-4-6
# PARSER_API=runtime        # runtime = bedrock-runtime; mantle = the lab's Claude 5.x endpoint
# PARSER_EFFORT=            # Claude 5.x only (low .. max)
# BEDROCK_REGION=us-east-1
# BUDGET_EMAIL=you@example.com             # defaults to REPORT_EMAIL
