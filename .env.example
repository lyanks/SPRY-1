# --- database ---
POSTGRES_USER=spry
POSTGRES_PASSWORD=spry
POSTGRES_DB=spry
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://spry:spry@db:5432/spry
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / cert-* / domain) ---
# Everything lands in AWS_REGION, tagged PROJECT_NAME=<PROJECT_NAME> (the
# frontend's certificate is always us-east-1, as CloudFront requires).
AWS_REGION=eu-central-1
PROJECT_NAME=spry
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role. Never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# Optional - leave both empty to skip custom domains. The API is then served
# over HTTPS from a *.cloudfront.net address and so is the frontend.
# With a domain: API_DOMAIN gets an ALB certificate (make cert-backend);
# APP_DOMAIN is the frontend's domain (make domain) and is allowed by CORS.
API_DOMAIN=
APP_DOMAIN=

# Written by make deploy-backend; make deploy-frontend builds against it.
BACKEND_URL=
# Written by make domain.
DOMAIN_NAME=
