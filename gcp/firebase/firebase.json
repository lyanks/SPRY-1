{
  "hosting": {
    "public": "../../frontend/out",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "spry-api", "region": "us-central1" } },
      { "source": "/health", "run": { "serviceId": "spry-api", "region": "us-central1" } },
      { "source": "/health/**", "run": { "serviceId": "spry-api", "region": "us-central1" } },
      { "source": "/docs", "run": { "serviceId": "spry-api", "region": "us-central1" } },
      { "source": "/openapi.json", "run": { "serviceId": "spry-api", "region": "us-central1" } }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=0,must-revalidate" }]
      }
    ]
  }
}
